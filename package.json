{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:test": "set \"NEXT_DIST_DIR=.next-playwright\" && set \"NEXTAUTH_SECRET=acadimies-playwright-only-secret-not-for-production\" && set \"NEXTAUTH_URL=http://127.0.0.1:3107\" && next dev --hostname 127.0.0.1 --port 3107",
    "build": "next build",
    "build:papaki": "next build --webpack",
    "start": "node start.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:failed": "playwright test --last-failed",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "wp:inspect": "tsx scripts/inspect-wordpress.ts",
    "wp:editorial-audit": "tsx scripts/audit-wordpress-editorial.ts",
    "wp:reconcile": "tsx scripts/reconcile-wordpress-publication.ts",
    "content:spam:inspect": "tsx scripts/remove-imported-spam-posts.ts",
    "content:spam:remove": "set \"ACADIMIES_SPAM_POSTS_APPLY=1\" && tsx scripts/remove-imported-spam-posts.ts",
    "wp:stage": "tsx scripts/stage-wordpress.ts",
    "wp:stage:apply": "set \"ACADIMIES_WP_STAGE_APPLY=1\" && tsx scripts/stage-wordpress.ts",
    "wp:media": "tsx scripts/import-wordpress-media.ts",
    "wp:media:apply": "set \"ACADIMIES_WP_MEDIA_APPLY=1\" && tsx scripts/import-wordpress-media.ts",
    "wp:media:apply:all": "set \"ACADIMIES_WP_MEDIA_APPLY=1\" && set \"ACADIMIES_WP_MEDIA_AUTO=1\" && tsx scripts/import-wordpress-media.ts",
    "wp:media:retry": "set \"ACADIMIES_WP_MEDIA_APPLY=1\" && tsx scripts/import-wordpress-media.ts",
    "wp:media:organize": "tsx scripts/organize-wordpress-media.ts",
    "wp:media:organize:apply": "set \"ACADIMIES_WP_MEDIA_ORGANIZE_APPLY=1\" && tsx scripts/organize-wordpress-media.ts",
    "wp:drafts": "tsx scripts/promote-wordpress-drafts.ts",
    "wp:drafts:apply": "set \"ACADIMIES_WP_DRAFT_APPLY=1\" && tsx scripts/promote-wordpress-drafts.ts",
    "wp:publish": "tsx scripts/promote-wordpress-drafts.ts",
    "wp:publish:apply": "set \"ACADIMIES_WP_PUBLISH_APPLY=1\" && tsx scripts/promote-wordpress-drafts.ts",
    "wp:posts:publish:all": "set \"ACADIMIES_WP_PUBLISH_APPLY=1\" && set \"ACADIMIES_WP_POSTS_AUTO=1\" && tsx scripts/promote-wordpress-drafts.ts",
    "admin:inspect": "tsx scripts/inspect-admin-backend.ts",
    "editor:media:inspect": "tsx scripts/inspect-editor-media.ts",
    "editor:media:migrate": "tsx scripts/migrate-editor-media.ts",
    "editor:media:register-demo": "tsx scripts/register-demo-webp.ts",
    "editor:media:register-demo:apply": "set \"ACADIMIES_REGISTER_DEMO_APPLY=1\" && tsx scripts/register-demo-webp.ts",
    "newsletter:inspect": "tsx scripts/inspect-newsletter-backend.ts",
    "newsletter:confirmations:inspect": "tsx scripts/deliver-newsletter-confirmations.ts",
    "newsletter:confirmations:deliver": "set \"ACADIMIES_NEWSLETTER_CONFIRMATION_APPLY=1\" && tsx scripts/deliver-newsletter-confirmations.ts",
    "search:index:inspect": "tsx scripts/public-search-index.ts",
    "search:index:migrate": "set \"ACADIMIES_SEARCH_INDEX_APPLY=1\" && tsx scripts/public-search-index.ts",
    "article:templates:inspect": "tsx scripts/migrate-article-templates.ts",
    "article:templates:migrate": "set \"ACADIMIES_ARTICLE_TEMPLATES_APPLY=1\" && tsx scripts/migrate-article-templates.ts",
    "redirects:inspect": "tsx scripts/migrate-post-redirects.ts",
    "redirects:migrate": "set \"ACADIMIES_POST_REDIRECTS_APPLY=1\" && tsx scripts/migrate-post-redirects.ts",
    "articles:scheduled:inspect": "tsx scripts/publish-scheduled-articles.ts",
    "articles:scheduled:publish": "set \"ACADIMIES_SCHEDULED_PUBLISH_APPLY=1\" && tsx scripts/publish-scheduled-articles.ts",
    "articles:scheduler:inspect": "tsx scripts/inspect-scheduled-publisher.ts",
    "articles:queue:inspect": "tsx scripts/inspect-publication-queue.ts",
    "syndication:inspect": "tsx scripts/inspect-editorial-syndication.ts",
    "authors:inspect": "tsx scripts/inspect-public-authors.ts",
    "topics:inspect": "tsx scripts/inspect-public-topics.ts",
    "analytics:inspect": "tsx scripts/migrate-readership-analytics.ts",
    "analytics:migrate": "set \"ACADIMIES_ANALYTICS_APPLY=1\" && tsx scripts/migrate-readership-analytics.ts",
    "release:inspect": "tsx scripts/inspect-release-readiness.ts",
    "production:preflight": "node scripts/production-preflight.mjs",
    "production:smoke": "node scripts/production-smoke.mjs",
    "production:schema:check": "node scripts/production-schema-check.mjs",
    "performance:inspect": "tsx scripts/inspect-performance-budget.ts",
    "content:repair:inspect": "tsx scripts/repair-editorial-metadata.ts",
    "content:repair:apply": "set \"ACADIMIES_CONTENT_REPAIR_APPLY=1\" && tsx scripts/repair-editorial-metadata.ts",
    "demo:golden-cup:inspect": "tsx scripts/seed-golden-cup-template-posts.ts",
    "demo:golden-cup:apply": "set \"ACADIMIES_GOLDEN_CUP_DEMO_APPLY=1\" && tsx scripts/seed-golden-cup-template-posts.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "adm-zip": "^0.6.1",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^5.11.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "mysql2": "^3.24.3",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.7",
    "react": "19.2.8",
    "react-cookie-consent": "^10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
