# Local MySQL database managed through phpMyAdmin.
# Copy to .env.local and replace only the credentials on your machine.
# Never commit .env.local or paste credentials into verification artifacts.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/next_acadimies
# Alternatively, keep the same phpMyAdmin-style fields used by the other projects:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=next_acadimies
# DB_USER=replace-with-database-user
# DB_PASSWORD=replace-with-database-password

# Public canonical origin. Keep localhost during local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Official public social destinations; defaults are the current Acadimies accounts.
NEXT_PUBLIC_ACADIMIES_FACEBOOK_URL=https://www.facebook.com/acadimies
NEXT_PUBLIC_ACADIMIES_INSTAGRAM_URL=https://www.instagram.com/acadimies/

# Keep preview until the reviewed Drizzle migrations are applied. Then use database.
PUBLICATION_DATA_SOURCE=preview

# Production-only safety switches. Keep delivery disabled through cutover.
ACADIMIES_CAMPAIGN_DELIVERY_ENABLED=false
ACADIMIES_NEWSLETTER_CONFIRMATION_APPLY=0

# Required for signed admin sessions. Generate a unique 32+ byte value locally.
NEXTAUTH_SECRET=replace-with-a-long-random-value
NEXTAUTH_URL=http://localhost:3000

# Environment-backed first owner. Login always uses this dedicated username.
# On successful login, only an Argon2 hash is persisted to MySQL.
ADMIN_USERNAME=replace-with-owner-login
ADMIN_PASSWORD=replace-with-at-least-12-characters
# Optional account email reserved for future password recovery and account changes.
ADMIN_EMAIL=optional-recovery-email@example.com
# Existing projects may use this alias instead of NEXTAUTH_SECRET.
ADMIN_SESSION_SECRET=replace-with-a-long-random-value

# Optional Google sign-in. Both values must be present to expose the button.
# Google users are still denied unless their email exists as an active DB staff user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Contact-form delivery through the same server-only SMTP transport used by the reference project.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_ENABLED=false
CONTACT_RECIPIENT_EMAIL=contact@example.com
# CONTACT_TO_EMAIL is also supported for compatibility with existing deployments.

# Required before enabling the protected scheduled-publication endpoint.
# Generate a unique random value of at least 32 characters and keep it server-only.
SCHEDULED_PUBLISH_SECRET=
